# ============================================
# SOCIALFLOW - FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copiar como .env y completar los valores
# IMPORTANTE: Las variables de React deben comenzar con REACT_APP_

# --- BACKEND URL ---
# Local:
REACT_APP_API_URL=http://localhost:5000
# Producción (Render):
# REACT_APP_API_URL=https://tu-api.onrender.com

# --- Para acceso desde red local con Google OAuth ---
# Obtener tu IP: ejecutar "ipconfig" (Windows) o "ifconfig" (Mac/Linux)
# Luego usar: http://192.168.X.XX.nip.io:3000
# Y agregar esa URL en Google Cloud Console > Authorized JavaScript origins
# REACT_APP_API_URL=http://192.168.X.XX.nip.io:5000

# --- APP ---
REACT_APP_NAME=SocialFlow
