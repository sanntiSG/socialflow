# ============================================
# SOCIALFLOW - BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copiar este archivo como .env y completar los valores

# --- SERVIDOR ---
PORT=5000
NODE_ENV=development
# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000
# URL del backend (para callbacks OAuth)
BACKEND_URL=http://localhost:5000

# --- MONGODB ATLAS ---
# Obtener en: https://cloud.mongodb.com
# Formato: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/socialflow?retryWrites=true&w=majority

# --- SESSION SECRET (generar uno aleatorio) ---
SESSION_SECRET=CAMBIAR_POR_STRING_ALEATORIO_LARGO_Y_SEGURO

# --- JWT ---
JWT_SECRET=CAMBIAR_POR_JWT_SECRET_ALEATORIO
JWT_EXPIRES_IN=7d

# --- GOOGLE OAUTH ---
# Obtener en: https://console.cloud.google.com
# Crear proyecto > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXX

# --- CLOUDINARY (para archivos de publicaciones programadas) ---
# Obtener en: https://cloudinary.com (gratis)
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET

# ============================================================
# REDES SOCIALES - OAuth Apps
# Cada red social requiere crear una app en su developer portal
# ============================================================

# --- INSTAGRAM / FACEBOOK ---
# Obtener en: https://developers.facebook.com
# Crear App > Add Product > Instagram Basic Display / Facebook Login
FACEBOOK_APP_ID=TU_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=TU_FACEBOOK_APP_SECRET
INSTAGRAM_APP_ID=TU_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=TU_INSTAGRAM_APP_SECRET

# --- TIKTOK ---
# Obtener en: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=TU_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=TU_TIKTOK_CLIENT_SECRET

# --- YOUTUBE (Google API) ---
# Mismo proyecto de Google Cloud, habilitar YouTube Data API v3
YOUTUBE_CLIENT_ID=MISMO_O_DIFERENTE_GOOGLE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=MISMO_O_DIFERENTE_GOOGLE_CLIENT_SECRET

# ============================================================
# DESPLIEGUE EN RENDER
# ============================================================
# En el dashboard de Render, agregar estas variables de entorno
# FRONTEND_URL = https://tu-app.netlify.app
# BACKEND_URL = https://tu-api.onrender.com
# El resto de variables igual que arriba

# ============================================================
# USO CON IP LOCAL (para acceso desde otros dispositivos)
# ============================================================
# Para usar Google OAuth con IP local, usar nip.io:
# Ejemplo: Si tu IP es 192.168.1.100
# FRONTEND_URL=http://192.168.1.100.nip.io:3000
# BACKEND_URL=http://192.168.1.100.nip.io:5000
# Y agregar estas URLs en Google Cloud Console como orígenes autorizados
